# ═════════════════════════════════════════════════════════════════════════════
# V Shots — Environment Configuration Template
# ═════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values for local development.
# NEVER commit .env or real secret keys to source control.
# ═════════════════════════════════════════════════════════════════════════════

# Supabase (Client-side access with RLS enabled)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# YouTube Data API v3 (Search & Video Metadata)
YOUTUBE_DATA_API_KEY=

# Google OAuth
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# BrowserStack Real-Device Testing (CI/CD)
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# Android Release Keystore Signing (CI/CD / Local)
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# ── AppLovin MAX (monetization layer) ────────────────────────────
# SDK (app) key from the AppLovin dashboard (Account → General → Keys).
# Client-safe by design (identifies the app, not a person).
# Leave empty locally ⇒ honest CONFIG_NOT_SET state, ads OFF, app unaffected.
#
# MAX ad unit IDs per STABLE V Shots placement (empty = that slot renders
# nothing — fail-safe).
APPLOVIN_MAX_SDK_KEY=
APPLOVIN_MAX_UNIT_HOME_NATIVE_01=
APPLOVIN_MAX_UNIT_DISCOVERY_NATIVE_01=
APPLOVIN_MAX_UNIT_PLAYER_NATIVE_01=
APPLOVIN_MAX_UNIT_LIBRARY_NATIVE_01=
APPLOVIN_MAX_UNIT_SEARCH_NATIVE_01=
APPLOVIN_MAX_UNIT_INTERSTITIAL_SESSION_BREAK_01=
APPLOVIN_MAX_UNIT_REWARDED_FEATURE_01=
APPLOVIN_MAX_UNIT_BANNER_HOME_01=
#
# ⚠️ SERVER-SIDE credentials (Management/Report/Event API keys) are NEVER
# put in .env — they are only used by scripts/max_setup.py via server env.
#
# Testing: MAX serves test ads to devices registered as TEST DEVICES in the
# MAX dashboard (the device ID appears in the MAX log on first connect).
# Debug builds have verbose logging + the creative/mediation debugger on.
