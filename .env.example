# ═════════════════════════════════════════════════════════════════════════════
# V Shots — Environment Configuration Template
# ═════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values for local development.
# NEVER commit .env or real secret keys to source control.
# ═════════════════════════════════════════════════════════════════════════════

# Supabase (Client-side access with RLS enabled)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# YouTube Data API v3 (Search & Video Metadata)
YOUTUBE_DATA_API_KEY=

# Google OAuth
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# BrowserStack Real-Device Testing (CI/CD)
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# Android Release Keystore Signing (CI/CD / Local)
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# ── Unity LevelPlay (monetization layer) ───────────────────────────
# App key from the LevelPlay dashboard (Apps → your app). Client-safe by
# design (identifies the app, not a person).
# Release builds use this production configuration.
LEVELPLAY_APP_KEY=
#
# LevelPlay ad unit IDs per stable V Shots placement.
LEVELPLAY_UNIT_INTERSTITIAL_SESSION_BREAK_01=
LEVELPLAY_UNIT_REWARDED_FEATURE_01=
# 300×250 Medium Rectangle (MREC) used by Home / Discover / Search.
LEVELPLAY_UNIT_MREC_300X250_01=
# Legacy banner key is retained only as a production fallback during migration.
LEVELPLAY_UNIT_BANNER_HOME_01=
#
# Debug builds intentionally use the official Unity LevelPlay TEST
# credentials so injected production secrets cannot cause a misleading
# "Mediation No Fill" during SDK/integration testing. To explicitly test
# production units in a debug build only, set:
# LEVELPLAY_DEBUG_USE_PRODUCTION=true
#
# ⚠️ SERVER-SIDE credentials (Management/Report/Event API keys) are NEVER
# put in .env — they are only used by dashboard automation via server env.
#
# Testing: LevelPlay serves test ads to devices registered as TEST DEVICES
# in the LevelPlay dashboard (Settings → Test devices). Debug builds have
# adapters-debug + the official integration test suite enabled.
