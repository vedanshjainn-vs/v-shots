# ═════════════════════════════════════════════════════════════════════════════
# V Shots — Environment Configuration Template
# ═════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values for local development.
# NEVER commit .env or real secret keys to source control.
# ═════════════════════════════════════════════════════════════════════════════

# Supabase (Client-side access with RLS enabled)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# YouTube Data API v3 (Search & Video Metadata)
YOUTUBE_DATA_API_KEY=

# Google OAuth
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# BrowserStack Real-Device Testing (CI/CD)
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# Android Release Keystore Signing (CI/CD / Local)
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# ── Google AdMob ────────────────────────────────────────────────
# Production ad unit IDs. In CI these come from GitHub secrets
# (ADMOB_NATIVE_AD_ID, ADMOB_INTERSTITIAL_AD_ID, ADMOB_REWARDED_AD_ID,
# ADMOB_BANNER_AD_ID) and the app ID from ADMOB_APP_ID. Leave ALL of these
# empty locally => the app builds with ads OFF (the safe default).
ADMOB_NATIVE_AD_ID=
ADMOB_INTERSTITIAL_AD_ID=
ADMOB_REWARDED_AD_ID=
ADMOB_BANNER_AD_ID=
# Development only: set to true to run OFFICIAL GOOGLE TEST ads in DEBUG
# builds (see AdConfig / AdPolicy). Ignored in release builds.
ADMOB_TEST_MODE=false
