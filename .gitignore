# Environment
# NOTE: .env IS committed for this project (see .env's own header
# comment) — it contains only the Supabase anon key (public-by-design,
# every table has RLS enabled) and a Google OAuth Client ID, neither of
# which is a secret. Real secrets (DB password, service_role key, any
# API tokens) must NEVER go in this file — use GitHub Actions Secrets
# instead. .env.local and .env.*.local remain ignored for any
# developer-local overrides that shouldn't be shared.
.env.local
.env.*.local
firebase_options.dart

# IDE
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

